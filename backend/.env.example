# ==== Spring Boot backend environment (copy to .env and fill in; .env is gitignored) ====
# Use the Supabase DIRECT connection (port 5432) so Flyway can run DDL/migrations.
# Find it in Supabase -> Project Settings -> Database -> Connection info.
DATABASE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-db-password>

# Schema the app/Flyway use (kept separate from existing Supabase tables).
DB_SCHEMA=gym_app

# >= 32 characters. Generate e.g.:  openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Google OAuth Web Client ID (same id used by both frontends).
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# First admin email(s) so you can log into the admin portal before the allowlist table has rows.
ADMIN_BOOTSTRAP_EMAILS=adityamalviya@velozityglobal.com
# Password seeded for the bootstrap admin accounts above, so they can log in with email/password.
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-admin-password

# Allowed browser origins for CORS (dev + prod).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://fit-zone-gym-sdge.vercel.app

# ==== Password-reset email (SMTP) ====
# MAIL_ENABLED=false logs the reset link instead of sending it (dev). Set true + fill SMTP to send.
# For Gmail, MAIL_PASSWORD must be an App Password (Google account -> Security -> App passwords).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<your-smtp-username>
MAIL_PASSWORD=<your-smtp-app-password>
MAIL_FROM=FitZone <no-reply@your-domain.com>

# Frontend base URLs used to build the reset link in the email.
FRONTEND_USER_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

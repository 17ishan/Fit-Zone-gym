# ==== Spring Boot backend environment (copy to .env and fill in; .env is gitignored) ====
# Use the Supabase DIRECT connection (port 5432) so Flyway can run DDL/migrations.
# Find it in Supabase -> Project Settings -> Database -> Connection info.
DATABASE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-db-password>

# Schema the app/Flyway use (kept separate from existing Supabase tables).
DB_SCHEMA=gym_app

# >= 32 characters. Generate e.g.:  openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Google OAuth Web Client ID (same id used by both frontends).
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# First admin email(s) so you can log into the admin portal before the allowlist table has rows.
ADMIN_BOOTSTRAP_EMAILS=adityamalviya@velozityglobal.com
# Password seeded for the bootstrap admin accounts above, so they can log in with email/password.
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-admin-password

# Allowed browser origins for CORS (dev + prod).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://fit-zone-gym-sdge.vercel.app

# ==== Transactional & notification email (SMTP) ====
# MAIL_ENABLED=false logs every email instead of sending it (dev). Set true + fill SMTP to send.
# The app is provider-agnostic: just point these at any SMTP relay.
#
# PRODUCTION: do NOT use Gmail. Cloud hosts often block outbound SMTP and Gmail
# throttles/flags sends from datacenter IPs (mail lands in spam or is rejected, ~500/day cap).
# Use a transactional provider instead — recommended: Brevo (free 300/day, sends to any
# recipient with just a verified sender email; no domain required to start).
#
#   Brevo:    MAIL_HOST=smtp-relay.brevo.com   MAIL_PORT=587 (or 2525 if 587 is blocked)
#             MAIL_USERNAME=<brevo-login-email> MAIL_PASSWORD=<brevo-SMTP-key>
#   SendGrid: MAIL_HOST=smtp.sendgrid.net      MAIL_PORT=587  MAIL_USERNAME=apikey  MAIL_PASSWORD=<api-key>
#   Mailgun:  MAIL_HOST=smtp.mailgun.org       MAIL_PORT=587  MAIL_USERNAME=<postmaster@...> MAIL_PASSWORD=<smtp-pass>
#
# Whichever you pick, MAIL_FROM must be a sender address you've verified in that provider.
# Local dev with Gmail still works: MAIL_HOST=smtp.gmail.com, MAIL_PASSWORD=<Gmail App Password>.
MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<your-smtp-login>
MAIL_PASSWORD=<your-smtp-key>
MAIL_FROM=FitZone <verified-sender@your-domain.com>
# Inbox that receives contact-form alerts (defaults to the MAIL_FROM address if blank).
MAIL_ADMIN_INBOX=
# Optional: SMTP socket timeout in ms (fail fast if the host blocks the port).
MAIL_TIMEOUT_MS=10000

# Frontend base URLs used to build the reset link in the email.
FRONTEND_USER_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# ==== Scheduled notification jobs (membership reminders, auto-expire, renewals, payments) ====
# Master switch; cron defaults run once daily. reminder days are comma-separated.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_REMINDER_DAYS=7,1
NOTIFICATIONS_RENEWAL_DAYS=3
NOTIFICATIONS_PAYMENT_HOURS=24

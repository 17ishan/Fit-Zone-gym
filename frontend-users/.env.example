# User site env (copy to .env; .env is gitignored).
# NOTE: every VITE_* value is embedded in the public browser bundle — never put
# server secrets here.

# Base URL of the deployed Spring Boot backend (no trailing slash).
VITE_API_URL=http://localhost:8080

# Google OAuth Web Client ID (same id used by the admin portal).
VITE_GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Gemini API key for the in-app AI chat.
# WARNING: this is shipped to the browser and is publicly readable. Prefer
# proxying Gemini calls through the backend instead. If you must use it here,
# scope/limit the key and rotate it regularly.
VITE_GEMINI_API_KEY=<your-gemini-api-key>
